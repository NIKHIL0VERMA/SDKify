{
  "name": "sdkify",
  "version": "0.1.0",
  "description": "Generate developer-friendly SDKs from OpenAPI specifications.",
  "type": "module",
  "scripts": {
    "generate": "tsx src/index.ts examples/kapso/openapi-platform.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "openapi",
    "sdk",
    "codegen",
    "generator"
  ],
  "license": "MIT",
  "dependencies": {
    "@scalar/openapi-parser": "^0.29.16",
    "@scalar/openapi-types": "^0.9.8",
    "twing": "^7.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
