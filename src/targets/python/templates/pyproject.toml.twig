[project]
name = "{{ sdk.name | caseKebab }}"
version = "{{ sdk.version }}"
description = "{{ sdk.description | firstLine | replace({'"': '\\"'}) }}"
requires-python = ">=3.10"
{{ dependenciesLine }}

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["{{ sdk.name | caseSnake }}"]

[tool.hatch.build.targets.sdist]
include = ["{{ sdk.name | caseSnake }}", "docs"]
