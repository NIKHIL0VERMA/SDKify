{% for service in sdkServices %}
import { {{ service.className }} } from "./services/{{ service.fileName }}.js";
{% endfor %}

export type QueryValue =
  | string
  | number
  | boolean
  | null
  | undefined
  | Array<string | number | boolean>;

export interface RequestOptions {
  method?: "GET" | "POST" | "PUT" | "PATCH" | "DELETE";
  query?: Record<string, QueryValue>;
  headers?: Record<string, string>;
  body?: unknown;
}

export interface ClientConfig {
  baseUrl?: string;
  
  fetch?: typeof fetch;
{% for auth in authSchemes %}
  {{ auth.configName }}?: string;
{% endfor %}
}

export class ApiError extends Error {
  readonly status: number;
  readonly body: unknown;

  constructor(status: number, body: unknown) {
    super(`HTTP ${status}`);
    this.name = "ApiError";
    this.status = status;
    this.body = body;
  }
}

export class Client {
  private readonly baseUrl: string;
  private readonly fetchImpl: typeof fetch;
{% for auth in authSchemes %}
  private readonly {{ auth.configName }}?: string;
{% endfor %}

{% for service in sdkServices %}
  readonly {{ service.instanceName }}: {{ service.className }};
{% endfor %}

  constructor(config: ClientConfig = {}) {
    this.baseUrl = config.baseUrl ?? "{{ baseUrl }}";
    this.fetchImpl = config.fetch ?? globalThis.fetch.bind(globalThis);
{% for auth in authSchemes %}
    this.{{ auth.configName }} = config.{{ auth.configName }};
{% endfor %}

{% for service in sdkServices %}
    this.{{ service.instanceName }} = new {{ service.className }}(this);
{% endfor %}
  }

  async request<T>(
    path: string,
    options: RequestOptions = {},
  ): Promise<T> {
    const url = new URL(this.baseUrl);
    url.pathname = path;

    if (options.query) {
      for (const [key, value] of Object.entries(options.query)) {
        if (value === undefined || value === null) {
          continue;
        }

        const values = Array.isArray(value) ? value : [value];

        for (const item of values) {
          url.searchParams.append(key, String(item));
        }
      }
    }

    const headers = new Headers();

    if (options.headers) {
      for (const [key, value] of Object.entries(options.headers)) {
        if (value !== undefined) {
          headers.set(key, value);
        }
      }
    }
{% for auth in authSchemes %}
{% if auth.kind == "apiKey" and auth.location == "header" %}
    if (this.{{ auth.configName }} !== undefined) {
      headers.set("{{ auth.wireName }}", this.{{ auth.configName }});
    }
{% elseif auth.kind == "http" and auth.scheme == "bearer" %}
    if (this.{{ auth.configName }} !== undefined) {
      headers.set("Authorization", `Bearer ${this.{{ auth.configName }}}`);
    }
{% endif %}
{% endfor %}

    const response = await this.fetchImpl(url, {
      method: options.method ?? "GET",
      headers,
      body:
        options.body instanceof FormData
          ? options.body
          : options.body !== undefined
            ? JSON.stringify(options.body)
            : undefined,
    });

    let responseBody: unknown;

    if (response.status !== 204 && response.headers.get("content-length") !== "0") {
      const text = await response.text();

      if (text.length > 0) {
        try {
          responseBody = JSON.parse(text);
        } catch {
          responseBody = text;
        }
      }
    }

    if (!response.ok) {
      throw new ApiError(response.status, responseBody);
    }

    return responseBody as T;
  }
}

export function createClient(config: ClientConfig = {}): Client {
  return new Client(config);
}
