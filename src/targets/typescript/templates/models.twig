{% for type in types %}
{% if type.description %}
/**
 * {{ type.description }}
 */
{% endif %}
{% if type.kind == "interface" %}
export interface {{ type.name }}{% if type.parents is not empty %} extends {{ type.parents | join(", ") }}{% endif %} {
{% for property in type.properties %}
{% if property.description %}
  /** {{ property.description }} */
{% endif %}
  {{ property.name }}{% if not property.required %}?{% endif %}: {{ property.tsType }};
{% endfor %}
}
{% else %}
export type {{ type.name }} = {{ type.tsType }};
{% endif %}

{% endfor %}