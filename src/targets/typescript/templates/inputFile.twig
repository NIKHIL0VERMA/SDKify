export class InputFile {
  readonly data: Blob;
  readonly name: string;

  private constructor(data: Blob, name: string) {
    this.data = data;
    this.name = name;
  }

  /**
   * Creates an upload from an in-memory buffer.
   */
  static fromBuffer(
    buffer: ArrayBuffer | Uint8Array | Blob,
    name = "file",
  ): InputFile {
    return new InputFile(new Blob([buffer as BlobPart]), name);
  }

  /**
   * Creates an upload from a file path.
   */
  static async fromPath(path: string, name?: string): Promise<InputFile> {
    const { readFile } = await import("node:fs/promises");
    const { basename } = await import("node:path");
    const buffer = await readFile(path);

    return new InputFile(new Blob([buffer]), name ?? basename(path));
  }
}
